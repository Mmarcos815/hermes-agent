      "path": "matrix/client/lib/visa_pay.js",
      "match": "        var payStatus = false;\n        //request options\n        var payment_request_options = {\n            uri: 'https://sandbox.api.visa.com/cybersource/payments/v1/sales?apikey=' + config.apiKey,\n"
