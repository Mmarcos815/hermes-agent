alert tcp any any -> any any (msg:"SQLi - Classic UNION SELECT Injection"; flow:established,to_server; content:"union"; http_uri; nocase; content:"select"; http_uri; nocase; distance:0; pcre:"/union\s+select/i"; classtype:web-application-attack; sid:2000001; rev:1;)
alert tcp any any -> any any (msg:"SQLi - Single Quote Injection Attempt"; flow:established,to_server; content:"'"; http_uri; pcre:"/(\%27|')((\%6F)|\o)|((\%27|')((\%6F)|\o)r)/i"; classtype:web-application-attack; sid:2000002; rev:1;)
alert tcp any any -> any any (msg:"SQLi - OR-based Authentication Bypass"; flow:established,to_server; content:"'or"; http_uri; nocase; pcre:"/'(\s)*(or|and)(\s)*(\d+|')=(\d+|')/i"; classtype:web-application-attack; sid:2000003; rev:1;)
alert tcp any any -> any any (msg:"SQLi - Tautology Injection Pattern"; flow:established,to_server; pcre:"/((\%27)|')\s*((\%6F)|o|(\%4F))((\%72)|r|(\%52))/i"; classtype:web-application-attack; sid:2000004; rev:1;)
alert tcp any any -> any any (msg:"SQLi - Comment-Based Injection Detection"; flow:established,to_server; content:"--"; http_uri; pcre:"/(--|\/\*|#|%23|%2D%2D)/"; classtype:web-application-attack; sid:2000005; rev:1;)
alert tcp any any -> any any (msg:"SQLi - Stacked Query Attempt"; flow:established,to_server; pcre:"/(insert|update|delete|drop|create|alter)\s+/Ui"; classtype:web-application-attack; sid:2000006; rev:1;)
alert tcp any any -> any any (msg:"SQLi - UNION-based Numeric Injection"; flow:established,to_server; content:"UNION"; http_uri; nocase; pcre:"/union\s+all\s+select/i"; classtype:web-application-attack; sid:2000007; rev:1;)
alert tcp any any -> any any (msg:"SQLi - SQL Function in Query String"; flow:established,to_server; pcre:"/(sleep|benchmark|waitfor|delay|pg_sleep|dbms_lock)\s*\(/Ui"; classtype:web-application-attack; sid:2000008; rev:1;)
alert tcp any any -> any any (msg:"SQLi - Hex-Encoded SQL Keywords"; flow:established,to_server; pcre:"/(0x756e696f6e|0x73656c656374|0x7768657265)/"; classtype:web-application-attack; sid:2000009; rev:1;)
