alert tcp any any -> any any (msg:"File Upload - PHP Extension in Upload"; flow:established,to_server; content:"filename="; http_header; nocase; pcre:"/filename=\"[^\"]*\.(php|php3|php4|php5|phtml|pht|phar)/Ui"; classtype:web-application-attack; sid:5000001; rev:1;)
