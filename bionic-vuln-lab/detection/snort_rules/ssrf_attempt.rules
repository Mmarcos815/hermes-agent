alert tcp any any -> any any (msg:"SSRF - Request to Internal IP Range 10.x"; flow:established,to_server; pcre:"/(https?:\/\/|%2F%2F)?10\.\d{1,3}\.\d{1,3}\.\d{1,3}/i"; classtype:web-application-attack; sid:3000001; rev:1;)
alert tcp any any -> any any (msg:"SSRF - Request to Internal IP Range 192.168.x"; flow:established,to_server; pcre:"/(https?:\/\/|%2F%2F)?192\.168\.\d{1,3}\.\d{1,3}/i"; classtype:web-application-attack; sid:3000002; rev:1;)
alert tcp any any -> any any (msg:"SSRF - Request to Internal IP Range 172.16-31.x"; flow:established,to_server; pcre:"/(https?:\/\/|%2F%2F)?172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3}/i"; classtype:web-application-attack; sid:3000003; rev:1;)
alert tcp any any -> any any (msg:"SSRF - Request to Loopback Address"; flow:established,to_server; pcre:"/(https?:\/\/|%2F%2F)?(127\.0\.0\.1|localhost|0\.0\.0\.0|::1|%5D%5B1)/i"; classtype:web-application-attack; sid:3000004; rev:1;)
alert tcp any any -> any any (msg:"SSRF - Link-Local Address 169.254.x Access"; flow:established,to_server; pcre:"/(https?:\/\/|%2F%2F)?169\.254\.\d{1,3}\.\d{1,3}/i"; classtype:web-application-attack; sid:3000005; rev:1;)
alert tcp any any -> any any (msg:"SSRF - Encoded Internal URL Parameter"; flow:established,to_server; content:"url="; http_uri; nocase; pcre:"/[?&]url=(https?%3A%2F%2F)?(10\.|192\.168\.|172\.(1[6-9]|2\d|3[0-1])\.|127\.)/Ui"; classtype:web-application-attack; sid:3000006; rev:1;)
alert tcp any any -> any any (msg:"SSRF - Cloud Metadata Endpoint Targeting"; flow:established,to_server; pcre:"/(169\.254\.169\.254|metadata\.google\.internal|169\.254\.170\.2)/i"; classtype:web-application-attack; sid:3000007; rev:1;)
alert tcp any any -> any any (msg:"SSRF - Internal Network Hostname Pattern"; flow:established,to_server; pcre:"/(https?:\/\/|%2F%2F)[a-zA-Z0-9-]+\.(internal|local|lan|corp|home|private)/i"; classtype:web-application-attack; sid:3000008; rev:1;)
