alert tcp any any -> any any (msg:"BOLA - Sequential User ID Enumeration Detected"; flow:established,to_server; content:"/api/users/"; http_uri; pcre:"/\/api\/users\/\d{1,5}(\?|$)/U"; threshold:type threshold, track by_src, count 20, seconds 10; classtype:web-application-attack; sid:1000001; rev:1;)
alert tcp any any -> any any (msg:"BOLA - Sequential User Profile Access Pattern"; flow:established,to_server; content:"/users/"; http_uri; content:"/profile"; http_uri; distance:0; within:20; pcre:"/\/users\/\d+\/profile/U"; threshold:type threshold, track by_src, count 10, seconds 5; classtype:web-application-attack; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"BOLA - User ID Incrementing in Query Parameter"; flow:established,to_server; content:"user_id="; http_uri; nocase; pcre:"/[?&]user_id=\d{1,5}(&|$)/U"; threshold:type threshold, track by_src, count 15, seconds 10; classtype:web-application-attack; sid:1000003; rev:1;)
alert tcp any any -> any any (msg:"BOLA - Account Enumeration via ID Path"; flow:established,to_server; content:"/account/"; http_uri; pcre:"/account\/\d{1,6}\//U"; threshold:type threshold, track by_src, count 20, seconds 10; classtype:web-application-attack; sid:1000004; rev:1;)
alert tcp any any -> any any (msg:"BOLA - Rapid Sequential ID Access in JSON Body"; flow:established,to_server; content:"{\"user_id\":"; nocase; pcre:"/\{\"user_id\":\d{1,5}\}/"; threshold:type threshold, track by_src, count 20, seconds 10; classtype:web-application-attack; sid:1000005; rev:1;)
alert tcp any any -> any any (msg:"BOLA - Customer ID Enumeration via REST API"; flow:established,to_server; content:"/customers/"; http_uri; pcre:"/customers\/\d{1,5}/U"; threshold:type threshold, track by_src, count 20, seconds 10; classtype:web-application-attack; sid:1000006; rev:1;)
alert tcp any any -> any any (msg:"BOLA - Sequential Numeric ID in POST Body"; flow:established,to_server; content:"POST"; http_method; pcre:"/id=\d{1,5}/Ui"; threshold:type threshold, track by_src, count 15, seconds 10; classtype:web-application-attack; sid:1000007; rev:1;)
alert tcp any any -> any any (msg:"BOLA - REST API User Resource Enumeration"; flow:established,to_server; content:"/v1/users/"; http_uri; pcre:"/v\d+\/users\/\d{1,5}/U"; threshold:type threshold, track by_src, count 15, seconds 10; classtype:web-application-attack; sid:1000008; rev:1;)
